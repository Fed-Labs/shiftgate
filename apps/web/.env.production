# SHIFTGATE web application production build defaults.
# Loaded by `next build` (overriding any local .env), so a production bundle
# never bakes a developer's localhost API origin. Override per-deploy with a
# real environment variable or .env.production.local.

# Control plane API
NEXT_PUBLIC_API_URL=https://shiftgate.dev

# Site URL for OG tags, metadataBase, robots, and sitemap
NEXT_PUBLIC_SITE_URL=https://shiftgate.dev
