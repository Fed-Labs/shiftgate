# SHIFTGATE web application environment configuration.
#
# Copy to .env for local development (dev server reads .env next to this file).
# Production builds read .env.production (checked in) and fail without
# NEXT_PUBLIC_API_URL — see next.config.ts.

# Control plane API
# Local agent/control-plane for development; production defaults live in
# .env.production.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8090

# Site URL for OG tags, metadataBase, robots, and sitemap
NEXT_PUBLIC_SITE_URL=https://shiftgate.dev
