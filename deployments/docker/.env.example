# Copy to .env (next to compose.yml) before `docker compose up`.
# Compose reads .env automatically from this directory.
#
# Every variable below is optional except POSTGRES_PASSWORD and the two
# peppers. The solo/production stack additionally requires PostgreSQL TLS
# material in ./postgres-tls and a configured rclone remote for off-host
# backups; compose.yml remains the explicit local-development stack.

# PostgreSQL superuser password for the compose database.
POSTGRES_PASSWORD=change-this

# Independent peppers for token and password hashing (openssl rand -hex 32).
# Losing either invalidates every session and password.
SHIFT_TOKEN_PEPPER=
SHIFT_PASSWORD_PEPPER=

# Browser origins allowed to call the API (comma separated), e.g.
# https://app.example.com — required for the web dashboard, not the CLI.
SHIFT_ALLOWED_ORIGINS=

# Host ports for the control plane and the agent peer listener.
SHIFT_CONTROL_PORT=8090
SHIFT_AGENT_PORT=8443

# Hosted checkpoint storage (`--profile storage`). When unset, the profile
# uses the evaluation-only defaults in compose.yml; production deployments
# must set both and keep them equal to the MinIO root credentials.
SHIFT_STORAGE_ENABLED=false
SHIFT_STORAGE_ACCESS_KEY_ID=
SHIFT_STORAGE_SECRET_ACCESS_KEY=
SHIFT_STORAGE_BUCKET=shift-checkpoints

# Solo production backup: remote must point at an operator-owned rclone path.
# Keep rclone.conf outside git and mount it with RCLONE_CONFIG_FILE.
RCLONE_REMOTE=
RCLONE_CONFIG_FILE=./rclone.conf
BACKUP_REMOTE_REQUIRED=true

# Solo production PostgreSQL TLS: ./postgres-tls must contain ca.crt,
# server.crt (SAN=postgres), and server.key (mode 0600).
