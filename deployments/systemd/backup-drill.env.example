# Environment for the scheduled restore drill. Install as root-owned 0600
# /etc/shift/backup-drill.env. Every path is explicit so the timer cannot
# accidentally restore over production state or a live database.
SHIFT_BACKUP_STATE_DIR=/var/lib/shift
SHIFT_BACKUP_OUTPUT_ROOT=/var/lib/shift-backups/drills
SHIFT_BACKUP_KEYS_ROOT=/var/lib/shift-key-escrow
SHIFT_BACKUP_RESTORE_STATE_DIR=/var/lib/shift-restore-drill
SHIFT_BACKUP_RESTORE_DATABASE_URL=postgres://shift:restore-only@127.0.0.1:5433/shift_restore?sslmode=verify-full&sslrootcert=/etc/shift/postgres-ca.pem
SHIFT_BACKUP_DATABASE_URL=postgres://shift:readonly@127.0.0.1:5432/shift?sslmode=verify-full&sslrootcert=/etc/shift/postgres-ca.pem
SHIFT_MASTER_KEY_FILE=/var/lib/shift-keyfile/master.key
SHIFT_VERIFY_BIN=/usr/local/bin/shift-verify
SHIFT_BACKUP_TEXTFILE_DIR=/var/lib/node_exporter/textfile
