# Environment for the SHIFT migration relay (deployments/systemd/shift-relay.service).
# Keep this file root-owned and mode 0600: it carries the ticket signing secret.
# install -m 0600 -o root -g root relay.env /etc/shift/relay.env
#
# The relay refuses to start without every item below: a durable leg store,
# a machine client CA, and a ticket audience (cmd/shift-relay). There is no
# insecure fallback; see docs/relay.md for the full prerequisite story.

# PostgreSQL leg store. One-use tickets are enforced by claim/consume rows in
# this database; without it the relay cannot refuse a replayed ticket. The
# same schema as shift-control migrates (relay legs live in the shared
# database), so point this at the fleet database.
SHIFT_DATABASE_URL=postgres://shift:change-me@127.0.0.1:5432/shift?sslmode=verify-full

# TLS listen address for relay-mediated transfer legs.
SHIFT_RELAY_LISTEN=0.0.0.0:9443

# TLS certificate and key for the relay's public listener. The inner agent
# mTLS remains the machine-identity boundary; the relay ticket only
# authorizes a short-lived leg and is never a substitute for peer TLS.
SHIFT_RELAY_CERT=/etc/shift/tls/relay.crt
SHIFT_RELAY_KEY=/etc/shift/tls/relay.key

# PEM bundle of the machine client CA: every relay leg must present a client
# certificate this CA signed, so the relay can bind legs to certified machine
# identities (the same CA the agents' tls.client_ca_file trusts).
SHIFT_RELAY_CLIENT_CA=/etc/shift/tls/machine-client-ca.pem

# Audience this relay accepts leg tickets bound to. Control plane and relay
# must agree; a ticket for another relay is refused.
SHIFT_RELAY_AUDIENCE=shift-relay

# 32+ byte secret the relay signs one-time leg tickets with (openssl rand -hex 32).
# Rotating it invalidates in-flight tickets only.
SHIFT_RELAY_SIGNING_KEY=
