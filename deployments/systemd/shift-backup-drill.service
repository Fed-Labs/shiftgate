[Unit]
Description=SHIFT encrypted backup restore drill
Documentation=https://github.com/Fed-Labs/shiftgate/blob/main/docs/backup-drill.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/shift/backup-drill.env
ExecStart=/usr/local/bin/shift-backup-drill
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=timers.target
