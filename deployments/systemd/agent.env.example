# Optional encrypted checkpoint object-store configuration.
# Keep this file root-owned with mode 0600 when it contains credentials.

# SHIFT_OBJECTSTORE_ENABLED=true
# SHIFT_OBJECTSTORE_BACKEND=s3
# SHIFT_S3_ENDPOINT=https://s3.example.com
# SHIFT_S3_REGION=us-east-1
# SHIFT_S3_BUCKET=shift-checkpoints
# SHIFT_S3_PREFIX=agents/production
# SHIFT_S3_ACCESS_KEY_ID=replace-me
# SHIFT_S3_SECRET_ACCESS_KEY=replace-me
# SHIFT_S3_SESSION_TOKEN=
# SHIFT_S3_FORCE_PATH_STYLE=false
# SHIFT_OBJECTSTORE_STATE_DIR=/var/lib/shift/objectstore-state

# For a local object store instead:
# SHIFT_OBJECTSTORE_ENABLED=true
# SHIFT_OBJECTSTORE_BACKEND=local
# SHIFT_OBJECTSTORE_LOCAL_ROOT=/var/lib/shift/cloud-objects

# Optional dashboard presence reporting. Create a dedicated API key with the
# "machines" scope, register the machine in shift-control first, then set:
# SHIFT_CONTROL_URL=https://control.example.test
# SHIFT_CONTROL_ORGANIZATION_ID=org_id
# SHIFT_CONTROL_MACHINE_ID=machine_id
# SHIFT_CONTROL_MACHINE_NAME=edge-01
# SHIFT_CONTROL_AGENT_URL=https://edge-01.example.test:8443
# SHIFT_CONTROL_API_KEY=shift_ak_...
# SHIFT_CONTROL_REPORT_INTERVAL=30s
